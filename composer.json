{
    "name": "ipropertypro/php-sdk",
    "description": "Framework-agnostic PHP client for the IPropertyPro Public API.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5|^12.0",
        "laravel/pint": "^1.18"
    },
    "suggest": {
        "ext-curl": "Needed by the bundled CurlTransport. Not required if you supply your own Transport (e.g. the Laravel bridge)."
    },
    "autoload": {
        "psr-4": {
            "IPropertyPro\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IPropertyPro\\Sdk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "fix": "pint"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
